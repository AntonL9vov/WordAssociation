# ===========================================
# Multiplayer Game - Production Environment
# ===========================================

# Database Configuration
POSTGRES_DB=multiplayer_game
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Server Configuration
NODE_ENV=production
PORT=3000
STORAGE_TYPE=postgres

# Database Connection (for server)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=multiplayer_game
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Client Configuration
VITE_API_BASE_URL_PROD=http://localhost:3000
VITE_API_WS_URL_PROD=ws://localhost:3000
VITE_ENV=production

# Optional: Redis Configuration (for scaling)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security (generate secure values for production)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
