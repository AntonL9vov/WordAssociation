{
  "name": "multiplayer-game-server",
  "version": "1.0.0",
  "description": "Word Association game server with automatic Swagger documentation",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "npm run swagger:generate && tsc -p tsconfig.build.json",
    "test": "vitest",
    "swagger:generate": "tsoa spec-and-routes",
    "swagger:spec": "tsoa spec",
    "swagger:routes": "tsoa routes",
    "asyncapi:generate": "ts-node src/scripts/generate-asyncapi.ts",
    "docs:generate": "npm run swagger:generate && npm run asyncapi:generate",
    "docs:dev": "npm run docs:generate && npm run dev",
    "dev:clean": "npm run docs:generate && npm run dev",
    "docs:build": "npm run docs:generate && npm run build",
    "prebuild": "npm run docs:generate",
    "migrate": "ts-node src/migrations/runner.ts",
    "migrate:build": "node dist/migrations/runner.js",
    "setup-hooks": "node scripts/setup-git-hooks.js",
    "postinstall": "npm run setup-hooks"
  },
  "dependencies": {
    "@asyncapi/generator": "^2.7.1",
    "@asyncapi/parser": "^3.4.0",
    "@asyncapi/react-component": "^2.6.3",
    "@asyncapi/studio": "^1.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "swagger",
    "openapi",
    "tsoa",
    "typescript",
    "automatic-documentation",
    "rest-api"
  ],
  "author": "Multiplayer Game Team",
  "license": "MIT"
}
